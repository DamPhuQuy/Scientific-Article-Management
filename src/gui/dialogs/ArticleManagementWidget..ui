  <property name="styleSheet">
   <string notr="true">/* --- Tổng thể Widget --- */
QWidget#ArticleManagementWidget {
    background-color: #f0f2f5; /* Nền sáng hơn một chút */
    font-family: Arial, sans-serif;
}

/* --- Tiêu đề --- */
QLabel#titleLabel {
    color: #333333;
    font-size: 28px;
    font-weight: bold;
    padding-bottom: 20px;
}

/* --- Các nút bấm chức năng (màu xanh/xám) --- */
QPushButton {
    background-color: #e0e6f0; /* Nền nút hơi xanh xám */
    color: #333333;
    border: 1px solid #c0c8d8;
    border-radius: 8px;
    padding: 15px 20px; /* Tăng padding để nút lớn hơn */
    font-size: 14px;
    font-weight: 600;
    text-align: left; /* Căn lề trái cho text */
    icon-size: 24px 24px; /* Kích thước icon */
    qproperty-iconPadding: 10px; /* Khoảng cách giữa icon và text */
}

QPushButton:hover {
    background-color: #d0d6e0;
    border-color: #a0a8b8;
}

/* Các nút chính như "Create", "View" có thể làm nổi bật hơn */
QPushButton#createArticleButton,
QPushButton#viewAllArticlesButton,
QPushButton#updateArticleButton,
QPushButton#deleteArticleButton,
QPushButton#searchArticlesButton,
QPushButton#statisticsButton {
    background-color: #007bff; /* Màu xanh nổi bật hơn */
    color: white;
    border-color: #0056b3;
}
QPushButton#createArticleButton:hover,
QPushButton#viewAllArticlesButton:hover,
QPushButton#updateArticleButton:hover,
QPushButton#deleteArticleButton:hover,
QPushButton#searchArticlesButton:hover,
QPushButton#statisticsButton:hover {
    background-color: #0056b3;
}

/* Nút "Back" */
QPushButton#backButton {
    background-color: #6c757d; /* Màu xám */
    color: white;
    border-color: #545b62;
}
QPushButton#backButton:hover {
    background-color: #545b62;
}
</string>
  </property>
