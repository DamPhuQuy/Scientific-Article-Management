  <property name="styleSheet">
   <string notr="true">
/* --- CÀI ĐẶT CHUNG --- */
QDialog#UserDetailsDialog {
    background-color: #f4f7f6;
    border: 4px solid #FFC085;
}
QWidget {
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
}

/* --- GROUP BOX --- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin-top: 20px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 15px;
    padding-right: 15px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #20B2AA;
    font-weight: bold;
    left: 10px;
    top: 0px;
}

/* --- LABELS --- */
QLabel {
    color: #333333;
}
/* Nhãn tiêu đề field (Username, Email...) */
QLabel#lblUsername, QLabel#lblFullName, QLabel#lblEmail, QLabel#lblPhoneNumer, QLabel#label {
    color: #555555;
    font-weight: bold;
}
/* Giá trị chi tiết */
QLabel#labelDetailUsername, QLabel#labelDetailFullname, QLabel#labelDetailEmail, QLabel#labelDetailPhoneNumber, QLabel#labelDetailKey {
    color: #000000;
    background-color: #f9f9f9;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 8px;
}

/* --- BUTTONS --- */
QPushButton {
    border-radius: 6px;
    font-weight: bold;
    padding: 10px 20px;
    min-width: 100px;
    color: white;
}
/* Nút Update (Xanh Ngọc) */
QPushButton#btnUpdate {
    background-color: #20B2AA;
    border: 2px solid #20B2AA;
}
QPushButton#btnUpdate:hover {
    background-color: #17a098;
}
/* Nút OK (Đỏ - Đóng) */
QPushButton#okBtn {
    background-color: #e74c3c;
    border: 2px solid #e74c3c;
}
QPushButton#okBtn:hover {
    background-color: #c0392b;
}
   </string>
