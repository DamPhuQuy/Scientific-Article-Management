  <property name="styleSheet">
   <string notr="true">/* --- Nền chung --- */
QWidget#EditAuthorDialog {
    background-color: #FFFFFF;
}
/* --- Tiêu đề "Edit Author Details" --- */
QLabel#titleLabel {
    font-size: 24px;
    font-family: "Times New Roman", serif;
    color: #000000;
    padding-bottom: 15px;
}
/* --- Các nhãn (Full name, Country...) --- */
QLabel[objectName$="Label"] {
    background-color: #12B0E8;
    color: white;
    border-radius: 6px;
    padding: 8px;
    font-size: 14px;
    font-weight: bold;
    min-width: 120px;
}
/* --- Các khung nhập liệu (QLineEdit) --- */
QLineEdit {
    border: none;
    border-bottom: 2px solid #000000;
    background-color: transparent;
    font-size: 16px;
    padding-left: 5px;
}
QLineEdit:focus {
    border-bottom: 2px solid #12B0E8;
}
/* --- Khung nhập số (QSpinBox) --- */
QSpinBox {
    border: none;
    border-bottom: 2px solid #000000;
    background-color: transparent;
    font-size: 16px;
    padding-left: 5px;
}
QSpinBox:focus {
    border-bottom: 2px solid #12B0E8;
}
QSpinBox::up-button, QSpinBox::down-button {
    border: none;
    width: 0px;
}
</string>
