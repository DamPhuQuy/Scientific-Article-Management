   <string notr="true">/* --- MAIN DIALOG --- */
QDialog#ArticleUpdateDialog { 
    background-color: #f4f7f6; 
    border: 4px solid #FFC085; /* Viền cam dịu */
}

QWidget { font-family: &quot;Segoe UI&quot;, Arial, sans-serif; font-size: 14px; }

/* --- HEADER --- */
QWidget#headerContainer { 
    background-color: #00264d; 
    border-bottom: 5px solid #4169E1; 
}
QLabel#lblHeaderTitle { color: #ffffff; font-size: 22px; font-weight: 900; padding-left: 10px; background: transparent; }

/* --- SCROLL AREA --- */
QScrollArea { border: 1px solid #20B2AA; border-radius: 8px; background-color: white; }

/* --- INPUTS --- */
QLineEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox { 
  background-color: #f9f9f9; 
  border: 1px solid #cccccc; 
  border-radius: 6px; 
  padding: 8px; 
  color: #333; 
}
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus { 
  background-color: #ffffff; 
  border: 2px solid #20B2AA; 
}

/* --- LABELS --- */
QLabel { font-weight: bold; color: #555; }
</string>
