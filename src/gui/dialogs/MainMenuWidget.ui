  <property name="styleSheet">
   <string notr="true">/* --- Tổng thể Widget --- */
QWidget#MainMenuWidget {
    background-color: #333333; /* Nền tối như hình mẫu */
}

/* --- Tiêu đề --- */
QLabel#titleLabel {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    padding-bottom: 15px;
}

/* --- Nút bấm chính (Màu xanh) --- */
QPushButton[objectName^=&quot;manage&quot;] {
    background-color: #0055ff; /* Màu xanh dương từ tiến trình (1) */
    color: white;
    border: none;
    border-radius: 15px; /* Bo tròn nhiều hơn cho giống hình mẫu */
    padding: 12px;
    font-size: 14px;
    font-weight: bold;
    min-height: 30px;
}
QPushButton[objectName^=&quot;manage&quot;]:hover {
    background-color: #0044cc;
}

/* --- Nút Thoát (Màu xám) --- */
QPushButton#exitButton {
    background-color: #666666;
    color: #FFFFFF;
    border: none;
    border-radius: 15px;
    padding: 12px;
    font-size: 14px;
    font-weight: bold;
    min-height: 30px;
}
QPushButton#exitButton:hover {
    background-color: #555555;
}</string>
