   <string notr="true">
/* --- CÀI ĐẶT CHUNG --- */
QDialog#ListOfAuthorsDialog {
    background-color: #f4f7f6;
    border: 4px solid #FFC085;
}
QWidget {
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
}

/* --- GROUP BOX --- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin-top: 20px;
    padding-top: 25px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #20B2AA;
    font-weight: bold;
    left: 10px;
    top: 0px;
}

/* --- INPUTS &amp; LABELS --- */
QLabel {
    color: #555555;
    font-weight: bold;
}
QLineEdit {
    background-color: #f9f9f9;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 8px;
    color: #333333;
}
QLineEdit:focus {
    background-color: #ffffff;
    border: 2px solid #20B2AA;
}

/* --- COMBOBOX (Tùy chỉnh để nổi bật danh sách) --- */
QComboBox {
    background-color: #f9f9f9;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 8px;
    padding-right: 30px; /* Chừa chỗ cho mũi tên */
    color: #333333;
}
QComboBox:focus, QComboBox:on { /* Khi click vào */
    background-color: #ffffff;
    border: 2px solid #20B2AA;
}

/* Tạo nút mũi tên bên phải nổi bật */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left-width: 1px;
    border-left-color: #cccccc;
    border-left-style: solid;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #e0e0e0; /* Nền xám cho nút mũi tên */
}
QComboBox::drop-down:hover {
    background-color: #d0d0d0;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
    /* Qt tự vẽ mũi tên đen, hoặc bạn có thể chèn ảnh vào đây */
}

/* Phần danh sách xổ xuống (Popup List) */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 2px solid #20B2AA; /* Viền xanh ngọc bao quanh list */
    selection-background-color: #e0f2f1; /* Nền xanh nhạt khi hover item */
    selection-color: #004d40; /* Chữ đậm khi hover item */
    outline: 0;
    padding: 5px;
}

/* --- LIST VIEW CHÍNH --- */
QListView {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 10px;
    outline: 0;
}
QListView::item {
    padding: 8px;
    border-bottom: 1px solid #eeeeee;
}
QListView::item:selected {
    background-color: #e0f2f1;
    color: #004d40;
    border-radius: 4px;
}
