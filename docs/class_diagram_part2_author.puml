@startuml Models - Author

' ============= STYLING =============
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classFontName Arial
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #2C3E50
skinparam classBorderThickness 1.5
skinparam ArrowColor #34495E
skinparam ArrowThickness 2
skinparam roundcorner 5

' ============= AUTHOR CLASS =============
class Author <<entity>> {
    - id: string
    - fullName: string
    - country: string
    - fieldOfStudy: string
    - totalPublications: int
    __
    + Author(...)
    __
    + getId(): string
    + getFullName(): string
    + getCountry(): string
    + getFieldOfStudy(): string
    + getTotalPublications(): int
    __
    + setFullName(name: string): void
    + setCountry(country: string): void
    + setFieldOfStudy(field: string): void
    + setTotalPublications(total: int): void
    __
    + to_json(): json
    + {static} from_json(j: json): Author
}

' ============= NOTE =============
note right of Author
  **Thực thể Author**

  Lưu trữ thông tin tác giả:
  • Tên đầy đủ
  • Quốc gia
  • Lĩnh vực nghiên cứu
  • Tổng số công bố

  Hỗ trợ JSON serialization
  cho import/export dữ liệu
end note

@enduml
