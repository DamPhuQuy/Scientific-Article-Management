   <string notr="true">
/* --- CÀI ĐẶT CHUNG --- */
QDialog#userUpdateInfo {
    background-color: #f4f7f6;
    border: 4px solid #FFC085;
}
QWidget {
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
}

/* --- HEADER --- */
QWidget#headerContainer {
    background-color: #00264d;
    border-bottom: 5px solid #4169E1;
    border-left: 10px solid #FFD700;
}

/* --- FOOTER CONTAINER (Đã chuyển CSS lên đây để không bị lỗi nút) --- */
QWidget#footerContainer {
    background-color: #ffffff;
    border-top: 1px solid #dddddd;
}

/* --- GROUP BOX --- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin-top: 15px;
    padding-top: 20px;
    padding-bottom: 15px;
    padding-left: 15px;
    padding-right: 15px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #20B2AA;
    font-weight: bold;
    left: 10px;
    top: 0px;
}

/* --- INPUTS &amp; LABELS --- */
QLabel {
    color: #333333;
}
QLineEdit {
    background-color: #f9f9f9;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 8px;
    color: #333333;
}
QLineEdit:focus {
    background-color: #ffffff;
    border: 2px solid #20B2AA;
}

/* Username Label (Read-only look) */
QLabel#txtUsername {
    color: #555555;
    font-weight: bold;
    background-color: #e0e0e0;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 8px;
}

/* --- BUTTONS (Quan trọng: Selector phải rõ ràng) --- */
QPushButton {
    border-radius: 6px;
    font-weight: bold;
    padding: 10px 20px;
    min-width: 100px;
    color: white;
}

/* Nút Save (Xanh Ngọc) */
QPushButton#btnSave {
    background-color: #20B2AA;
    border: 2px solid #20B2AA;
}
QPushButton#btnSave:hover {
    background-color: #17a098;
}
QPushButton#btnSave:pressed {
    background-color: #0e6b65;
}

/* Nút Cancel (Đỏ) */
QPushButton#btnCancel {
    background-color: #e74c3c;
    border: 2px solid #e74c3c;
}
QPushButton#btnCancel:hover {
    background-color: #c0392b;
}
QPushButton#btnCancel:pressed {
    background-color: #922b21;
}
