   <string notr="true">
/* --- CÀI ĐẶT CHUNG --- */
QWidget#ArticleForm {
    background-color: #f4f7f6;
    border: 4px solid #FFC085;
}
QWidget {
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
}

/* --- SIDEBAR --- */
QWidget#sidebarContainer {
    background-color: #ffffff;
    border-right: 1px solid #e0e0e0;
}
/* Nhãn tiêu đề trong sidebar */
QLabel.sectionLabel {
    color: #20B2AA;
    font-weight: bold;
    font-size: 12px;
    margin-top: 10px;
    margin-bottom: 5px;
}

/* --- INPUTS &amp; COMBOBOX --- */
QLineEdit, QComboBox {
    background-color: #f9f9f9;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 8px;
    padding-right: 30px;
    color: #333333;
}
QLineEdit:focus, QComboBox:focus {
    background-color: #ffffff;
    border: 2px solid #20B2AA;
}

/* Style cho ComboBox Dropdown */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #cccccc;
    background-color: #e0e0e0;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 2px solid #20B2AA;
    selection-background-color: #e0f2f1;
    selection-color: #004d40;
    outline: 0;
    padding: 5px;
}

/* --- BUTTONS --- */
QPushButton {
    border-radius: 6px;
    font-weight: bold;
    padding: 10px;
}
/* Nút User */
QPushButton#userLb {
    background-color: #e0f2f1;
    color: #00695c;
    border: 1px solid #b2dfdb;
    text-align: left;
    padding-left: 15px;
}
QPushButton#userLb:hover {
    background-color: #b2dfdb;
    border: 2px solid #20B2AA;
    color: #004d40;
}
/* Nút Hành động chính (Xanh Ngọc) */
QPushButton#newArticleBtn, QPushButton#pushButton {
    background-color: #20B2AA;
    border: 2px solid #20B2AA;
    color: white;
}
QPushButton#newArticleBtn:hover, QPushButton#pushButton:hover {
    background-color: #17a098;
}

/* Nút Back (Xám) */
QPushButton#backBtn {
    background-color: #7f8c8d;
    border: 2px solid #7f8c8d;
    color: white;
}
QPushButton#backBtn:hover {
    background-color: #636e72;
}

/* --- LIST VIEW --- */
QListView {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 10px;
    outline: 0;
}
QListView::item {
    padding: 10px;
    border-bottom: 1px solid #eeeeee;
}
QListView::item:selected {
    background-color: #e0f2f1;
    color: #004d40;
    border-radius: 4px;
}
