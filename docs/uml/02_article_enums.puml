@startuml Article Enumerations
skinparam classAttributeIconSize 0
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor<<enumeration>> LightBlue
    BorderColor Black
}

enum ArticleStatus <<enumeration>> {
    DRAFT = 11
    SUBMITTED = 12
    UNDER_REVIEW = 13
    REVISIONS = 14
    ACCEPTED = 15
    REJECTED = 16
    PUBLISHED = 17
}

enum Type <<enumeration>> {
    SCIE = 1
    SCOPUS = 2
    CONFERENCE = 3
    OTHER = 4
    CUSTOM = 5
}

note right of ArticleStatus
  Trạng thái của bài báo
  trong quy trình xuất bản
end note

note right of Type
  Loại bài báo theo
  cơ sở dữ liệu
end note

@enduml
