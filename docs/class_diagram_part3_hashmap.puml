@startuml Data Structure - HashMap

' ============= STYLING =============
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classFontName Arial
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #2C3E50
skinparam classBorderThickness 1.5
skinparam ArrowColor #34495E
skinparam ArrowThickness 2
skinparam roundcorner 5

' ============= HASHMAP CLASS =============
class "HashMap<K, V>" as HashMap <<template>> {
    - containers: vector<unique_ptr<Node>>
    - numElements: unsigned int
    - capacity: unsigned int
    - {static} MAX_LOAD_FACTOR = 0.75
    __
    - hashKey(key: K): unsigned int
    - rehash(): void
    __
    + HashMap(initCap: unsigned int = 10)
    + ~HashMap()
    __
    + size(): unsigned int
    + isEmpty(): bool
    + clear(): void
    __
    + put(key: K, value: V): void
    + get(key: K): V&
    + containsKey(key: K): bool
    + remove(key: K): bool
    __
    + keys(): vector<K>
    + values(): vector<V>
    + forEach(func): void
}

' ============= NODE CLASS =============
class Node <<inner>> {
    + key: K
    + value: V
    + next: unique_ptr<Node>
    __
    + Node(k: K, v: V)
}

' ============= RELATIONSHIP =============
HashMap +-- Node : contains

' ============= NOTES =============
note top of HashMap
  **Thư viện HashMap tự thiết kế**

  Template generic cho key-value pairs
  Áp dụng kỹ thuật:
  • Chaining để xử lý collision
  • Auto-rehash khi load factor > 0.75
  • Smart pointer để quản lý bộ nhớ

  Độ phức tạp trung bình: O(1)
end note

note right of Node
  **Inner Node Class**

  Cấu trúc node trong
  linked list để xử lý
  collision bằng chaining

  Sử dụng unique_ptr
  cho memory safety
end note

@enduml
