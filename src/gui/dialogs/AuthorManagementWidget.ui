  <property name="styleSheet">
   <string notr="true">/* --- Tổng thể Widget --- */
QWidget#AuthorManagementWidget {
    background-color: #f0f2f5; /* Nền sáng */
    font-family: Arial, sans-serif;
}

/* --- Tiêu đề --- */
QLabel#titleLabel {
    color: #333333;
    font-size: 28px;
    font-weight: bold;
    padding-bottom: 20px;
}

/* --- Các nút bấm chức năng --- */
QPushButton {
    background-color: #e0e6f0;
    color: #333333;
    border: 1px solid #c0c8d8;
    border-radius: 8px;
    padding: 15px 20px; /* Nút lớn */
    font-size: 14px;
    font-weight: 600;
    text-align: left; /* Căn lề trái cho text */
    icon-size: 24px 24px; /* Kích thước icon */
    qproperty-iconPadding: 10px; /* Khoảng cách icon và text */
}

QPushButton:hover {
    background-color: #d0d6e0;
    border-color: #a0a8b8;
}

/* Nút bấm chính (màu xanh) */
QPushButton#createAuthorButton,
QPushButton#viewAllAuthorsButton,
QPushButton#updateAuthorButton,
QPushButton#deleteAuthorButton,
QPushButton#searchAuthorsButton,
QPushButton#statisticsButton {
    background-color: #007bff; /* Màu xanh dương */
    color: white;
    border-color: #0056b3;
}
QPushButton#createAuthorButton:hover,
QPushButton#viewAllAuthorsButton:hover,
QPushButton#updateAuthorButton:hover,
QPushButton#deleteAuthorButton:hover,
QPushButton#searchAuthorsButton:hover,
QPushButton#statisticsButton:hover {
    background-color: #0056b3;
}

/* Nút "Back" (màu xám) */
QPushButton#backButton {
    background-color: #6c757d;
    color: white;
    border-color: #545b62;
}
QPushButton#backButton:hover {
    background-color: #545b62;
}</string>
  </property>
