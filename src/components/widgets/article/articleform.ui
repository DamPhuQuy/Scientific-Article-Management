  <property name="styleSheet">
   <string notr="true">/* Áp dụng riêng cho menu chính */
QWidget#ArticleForm {
    background-color: #f4f7f6;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
}

/* Header Container */
QWidget#headerContainer {
    background-color: #00264d;
    border-left: 10px solid #FFD700;
    border-bottom: 5px solid #4169E1;
}

/* Body container */
QWidget#bodyContainer {
    background-color: #ffffff;
    border: 2px solid #20B2AA;
    border-radius: 8px;
}

/* Chỉ style cho line edit trong ArticleForm */
QWidget#ArticleForm QLineEdit,
QWidget#ArticleForm QComboBox {
    background-color: #f9f9f9;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    /* ĐÃ SỬA: Đổi từ #fffcfcff sang #555 để hiện rõ chữ và đúng cú pháp */
    color: #555;
    min-height: 25px;
}

QWidget#ArticleForm QLineEdit:focus,
QWidget#ArticleForm QComboBox:focus {
    background-color: #ffffff;
    border: 2px solid #20B2AA;
    color: #000;
}

/* Dropdown */
QWidget#ArticleForm QComboBox::drop-down {
    border: 0px;
}

/* Label CHUNG (Sẽ bị ghi đè bởi style riêng của Title) */
QWidget#ArticleForm QLabel {
    font-weight: bold;
    color: #555;
    font-size: 14px;
}

/* Buttons */
QWidget#ArticleForm QPushButton {
    border-radius: 6px;
    font-weight: bold;
    padding: 8px 16px;
    min-height: 25px;
    font-size: 14px;
    color: white;
}

/* Search + Add article buttons */
QWidget#ArticleForm QPushButton#searchBtn,
QWidget#ArticleForm QPushButton#newArticleBtn {
    background-color: #20B2AA;
    border: 2px solid #20B2AA;
}
QWidget#ArticleForm QPushButton#searchBtn:hover,
QWidget#ArticleForm QPushButton#newArticleBtn:hover {
    background-color: #17a098;
    border-color: #17a098;
}

/* Delete + Back buttons */
QWidget#ArticleForm QPushButton#RemoveArticleBtn,
QWidget#ArticleForm QPushButton#backBtn {
    background-color: #da3e36;
    border: 2px solid #da3e36;
}
QWidget#ArticleForm QPushButton#RemoveArticleBtn:hover,
QWidget#ArticleForm QPushButton#backBtn:hover {
    background-color: #c0392b;
    border-color: #c0392b;
}

/* List view */
QWidget#ArticleForm QListView {
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 5px;
    background-color: #fff;
    font-size: 14px;
}

QWidget#ArticleForm QListView::item {
    padding: 10px;
    border-bottom: 1px solid #eee;
}

QWidget#ArticleForm QListView::item:selected {
    background-color: #e0f2f1;
    color: #000;
    border-left: 4px solid #20B2AA;
}

/* Separator */
QWidget#ArticleForm QFrame#lineSeparator {
    min-height: 3px;
    max-height: 3px;
    background-color: #20B2AA;
    border: none;
}
</string>
