  <property name="styleSheet">
<string notr="true">
/* === GLOBAL SETTINGS === */
QWidget#LoginForm {
    background-color: #f4f7f6;
}
QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
}

/* === MAIN CONTAINER === */
QWidget#container {
    background-color: #ffffff;
    border: 2px solid #20B2AA;
    border-radius: 12px;
}

/* === HEADER === */
QWidget#headerWidget {
    background-color: #00264d;
    border-left: 8px solid #FFD700;
    border-bottom: 4px solid #4169E1;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QLabel#welcomeLabel,
QLabel#logoLabel,
QLabel#subtitleLabel {
    color: #ffffff;
    background-color: transparent;
}
QLabel#welcomeLabel {
    font-size: 18px;
    font-weight: bold;
}
QLabel#subtitleLabel {
    font-size: 12px;
    font-style: italic;
    color: #dddddd;
}

/* === INPUT LABELS === */
QLabel#usernameLabel,
QLabel#passwordLabel {
    color: #333;
    font-weight: bold;
    font-size: 14px;
    margin-top: 10px;
}

/* === INPUT BOXES === */
QLineEdit {
    background-color: #f9f9f9;
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 10px;
    font-size: 14px;
    color: #333;
}
QLineEdit:focus {
    background-color: #ffffff;
    border: 2px solid #20B2AA;
}

/* === SIGN IN BUTTON === */
QPushButton#signInButton {
    background-color: #20B2AA;
    color: white;
    font-weight: bold;
    font-size: 16px;
    border-radius: 6px;
    border: none;
}
QPushButton#signInButton:hover {
    background-color: #17a098;
}
QPushButton#signInButton:pressed {
    background-color: #13857e;
}

/* === SIGN UP LINK === */
QLabel#signUpPromptLabel {
    color: #666;
}
QLabel#signUpLabel {
    font-weight: bold;
}

/* === MESSAGE BOX === */
QMessageBox {
    background-color: #ffffff;
    border: 2px solid #00264d;
    border-radius: 8px;
}
QMessageBox QLabel {
    color: #333333;
    font-size: 14px;
}
QMessageBox QPushButton {
    background-color: #20B2AA;
    color: white;
    font-weight: bold;
    font-size: 13px;
    padding: 6px 20px;
    border-radius: 4px;
    border: none;
    min-width: 60px;
}
QMessageBox QPushButton:hover {
    background-color: #17a098;
}
QMessageBox QPushButton:pressed {
    background-color: #13857e;
}
</string>

