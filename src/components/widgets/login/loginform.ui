  <property name="styleSheet">
   <string notr="true">
    /* --- MAIN FORM --- */
    QWidget#LoginForm {
        background-color: #f4f7f6;
        border: 4px solid #FFC085; /* Viền cam nhận diện */
    }

    QWidget { font-family: &quot;Segoe UI&quot;, Arial, sans-serif; font-size: 14px; }

    /* --- CONTAINER (HỘP ĐĂNG NHẬP) --- */
    QWidget#container {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
    }

    /* --- LABELS --- */
    QLabel#welcomeLabel {
        font-size: 26px;
        font-weight: 900;
        color: #00264d; /* Xanh đậm */
    }
    QLabel#subtitleLabel {
        color: #777;
        font-size: 13px;
        margin-bottom: 10px;
    }
    QLabel#usernameLabel, QLabel#passwordLabel {
        font-weight: bold;
        color: #333;
        margin-top: 5px;
    }
    QLabel#signUpPromptLabel {
        color: #666;
        font-size: 13px;
    }
    QLabel#signUpLabel {
        color: #20B2AA;
        font-weight: bold;
        font-size: 13px;
    }
    QLabel#signUpLabel:hover {
        color: #17a098;
        text-decoration: underline;
    }

    /* --- INPUT FIELDS --- */
    QLineEdit {
      background-color: #f9f9f9;
      border: 1px solid #cccccc;
      border-radius: 6px;
      padding: 10px;
      color: #333;
      font-size: 14px;
    }
    QLineEdit:focus {
      background-color: #ffffff;
      border: 2px solid #20B2AA; /* Viền xanh ngọc khi focus */
    }
   </string>
