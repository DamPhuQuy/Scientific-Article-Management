  <property name="styleSheet">
   <string notr="true">QWidget#AuthorForm { background-color: #f4f7f6; }
QWidget { font-family: &quot;Segoe UI&quot;, Arial, sans-serif; }

/* HEADER */
QWidget#headerContainer { background-color: #00264d; border-left: 10px solid #FFD700; border-bottom: 5px solid #4169E1; }
QLabel#lblPageTitle { color: #ffffff; font-size: 24px; font-weight: 900; background-color: transparent; padding-left: 10px; }

/* BODY */
QWidget#bodyContainer { background-color: #ffffff; border: 2px solid #20B2AA; border-radius: 8px; }

/* INPUTS */
QLineEdit { background-color: #f9f9f9; border: 1px solid #cccccc; border-radius: 6px; padding: 8px 12px; font-size: 14px; color: #333; min-height: 25px; }
QLineEdit:focus { background-color: #ffffff; border: 2px solid #20B2AA; color: #000; }

QLabel { font-weight: bold; color: #555; font-size: 14px; }

/* BUTTONS CHUNG */
QPushButton { border-radius: 6px; font-weight: bold; padding: 8px 16px; min-height: 25px; font-size: 14px; color: white; }

/* === NHÓM MÀU XANH NGỌC (TÍCH CỰC) === */
QPushButton#searchBtn, QPushButton#newAuthorBtn, QPushButton#updateAuthorBtn, QPushButton#statsBtn { background-color: #20B2AA; border: 2px solid #20B2AA; }
QPushButton#searchBtn:hover, QPushButton#newAuthorBtn:hover, QPushButton#updateAuthorBtn:hover, QPushButton#statsBtn:hover { background-color: #17a098; border-color: #17a098; }

/* === NHÓM MÀU ĐỎ (TIÊU CỰC/THOÁT) === */
QPushButton#removeAuthorBtn, QPushButton#backBtn { background-color: #da3e36; border: 2px solid #da3e36; }
QPushButton#removeAuthorBtn:hover, QPushButton#backBtn:hover { background-color: #c0392b; border-color: #c0392b; }

/* TABLE VIEW */
QTableView { border: 1px solid #e0e0e0; border-radius: 6px; padding: 5px; background-color: #fff; font-size: 14px; gridline-color: #eee; }
QTableView::item { padding: 5px; }
QTableView::item:selected { background-color: #e0f2f1; color: #000; }
QHeaderView::section { background-color: #f0f0f0; padding: 5px; border: none; border-bottom: 1px solid #ccc; font-weight: bold; }

/* LINE SEPARATOR */
QFrame#lineSeparator { min-height: 3px; max-height: 3px; background-color: #20B2AA; border: none; }</string>
