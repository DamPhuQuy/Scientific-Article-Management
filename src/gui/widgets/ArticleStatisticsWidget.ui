  <property name="styleSheet">
   <string notr="true">/* --- Nền chung --- */
QWidget#ArticleStatisticsWidget {
    background-color: #f0f2f5;
    font-family: Arial, sans-serif;
}
/* --- Tiêu đề --- */
QLabel#titleLabel {
    color: #333333;
    font-size: 28px;
    font-weight: bold;
    padding-bottom: 20px;
}
/* --- Các nút bấm chức năng --- */
QPushButton {
    background-color: #007bff; /* Màu xanh */
    color: white;
    border: 1px solid #0056b3;
    border-radius: 8px;
    padding: 15px 20px;
    font-size: 14px;
    font-weight: 600;
    text-align: left;
    icon-size: 24px 24px;
    qproperty-iconPadding: 10px;
}
QPushButton:hover {
    background-color: #0056b3;
}
/* --- Nút "Back" --- */
QPushButton#backButton {
    background-color: #6c757d; /* Màu xám */
    border-color: #545b62;
}
QPushButton#backButton:hover {
    background-color: #545b62;
}</string>
