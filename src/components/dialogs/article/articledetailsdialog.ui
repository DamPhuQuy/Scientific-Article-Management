  <property name="styleSheet">
   <string notr="true">
/* --- CÀI ĐẶT CHUNG --- */
QDialog#ArticleDetailsDialog {
    background-color: #f4f7f6;
    border: 4px solid #FFC085;
}
QWidget {
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
}

/* --- SCROLL AREA --- */
QScrollArea {
    border: none;
    background-color: transparent;
}

/* --- GROUP BOX --- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin-top: 20px;
    padding-top: 20px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #20B2AA;
    font-weight: bold;
    left: 10px;
    top: 0px;
}

/* --- LABELS --- */
QLabel {
    color: #333333;
}
QLabel#lblTitle {
    color: #004d40;
    font-weight: 900;
    font-size: 20px;
    margin-bottom: 10px;
}
QLabel#lblId {
    color: #7f8c8d;
    font-style: italic;
    font-size: 12px;
}
QLabel#lblVenue {
    font-weight: bold;
    color: #00264d;
    font-size: 15px;
}
/* Badge Styles */
QLabel#lblType, QLabel#lblStatus {
    font-weight: bold;
    color: #555555;
}

/* --- LIST &amp; TEXT BROWSER --- */
QListWidget, QTextBrowser {
    background-color: #f9f9f9;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 5px;
}

/* --- COMBOBOX (Read-only view style) --- */
QComboBox {
    background-color: #f9f9f9;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 5px;
    color: #333333;
}
QComboBox::drop-down {
    border: 0px;
}

/* --- FOOTER CONTAINER --- */
QWidget#footerContainer {
    background-color: #ffffff;
    border-top: 1px solid #dddddd;
    min-height: 60px; /* Quan trong: Giu cho footer khong bi mat */
}

/* --- BUTTONS --- */
/* QUAN TRONG: Set border: none de kich hoat custom background */
QPushButton {
    border: none;
    border-radius: 6px;
    font-weight: bold;
    padding: 10px;
    min-width: 100px;
    color: white;
}
QPushButton:pressed {
    padding-top: 12px; /* Hieu ung nhan nut */
    padding-left: 12px;
}

/* Nút Update (Xanh Ngoc) */
QPushButton#btnUpdate {
    background-color: #20B2AA;
    border: 2px solid #20B2AA;
}
QPushButton#btnUpdate:hover {
    background-color: #17a098;
}

/* Nút Remove (Do) */
QPushButton#removeBtn {
    background-color: #e74c3c;
    border: 2px solid #e74c3c;
}
QPushButton#removeBtn:hover {
    background-color: #c0392b;
}

/* Nút Close (Xam) */
QPushButton#closeBtn {
    background-color: #7f8c8d;
    border: 2px solid #7f8c8d;
}
QPushButton#closeBtn:hover {
    background-color: #636e72;
}

/* Nút Export (Cam) */
QPushButton#btnExport {
    background-color: #f39c12;
    border: 2px solid #f39c12;
}
QPushButton#btnExport:hover {
    background-color: #d68910;
}
   </string>
