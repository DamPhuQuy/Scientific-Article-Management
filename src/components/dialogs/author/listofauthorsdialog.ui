  <property name="styleSheet">
   <string notr="true">QDialog#ListOfAuthorsDialog { background-color: #f4f7f6; font-family: &quot;Segoe UI&quot;, Arial, sans-serif; }
QWidget#headerContainer { background-color: #00264d; border-left: 10px solid #FFD700; border-bottom: 5px solid #4169E1; }
QLabel#lblTitle { color: #ffffff; font-size: 24px; font-weight: 900; background-color: transparent; padding-left: 10px; }
QWidget#bodyContainer { background-color: #ffffff; border: 2px solid #20B2AA; border-radius: 8px; }
QLineEdit, QComboBox { background-color: #f9f9f9; border: 1px solid #cccccc; border-radius: 6px; padding: 8px 12px; font-size: 14px; color: #555; min-height: 25px; }
QLineEdit:focus, QComboBox:focus { background-color: #ffffff; border: 2px solid #20B2AA; color: #000; }
QComboBox::drop-down { border: 0px; }
QLabel { font-weight: bold; color: #555; font-size: 14px; }
QPushButton { border-radius: 6px; font-weight: bold; padding: 8px 16px; min-height: 25px; font-size: 14px; color: white; }
QPushButton#btnApplyFilter, QPushButton#okBtn { background-color: #20B2AA; border: 2px solid #20B2AA; }
QPushButton#btnApplyFilter:hover, QPushButton#okBtn:hover { background-color: #17a098; border-color: #17a098; }
QPushButton#btnClose { background-color: #da3e36; border: 2px solid #da3e36; }
QPushButton#btnClose:hover { background-color: #c0392b; border-color: #c0392b; }
QListView { border: 1px solid #e0e0e0; border-radius: 6px; padding: 5px; background-color: #fff; font-size: 14px; }
QListView::item { padding: 10px; border-bottom: 1px solid #eee; }
QListView::item:selected { background-color: #e0f2f1; color: #000; border-left: 4px solid #20B2AA; }
QFrame#lineSeparator { min-height: 3px; max-height: 3px; background-color: #20B2AA; border: none; }</string>
