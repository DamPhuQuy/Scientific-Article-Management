  <property name="styleSheet">
   <string notr="true">
    /* === NỀN CHUNG === */
    QMainWindow {
        background-color: #f4f7f6;
    }
    QWidget {
        font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    }

    /* === HEADER TRƯỜNG === */
    QLabel#lblHeader {
        background-color: #00264d; /* Nền xanh tối để chữ trắng nổi bật */
        color: #ffffff;             /* Chữ màu trắng */
        font-size: 20px;
        font-weight: bold;
        padding: 20px;              /* Khoảng cách đệm để không đè chữ */
        
        /* Đường viền sọc vàng bên trái */
        border-left: 8px solid #FFD700; 
        
        /* Đường kẻ ngang màu King Blue bên dưới */
        border-bottom: 4px solid #4169E1; 
    }

    /* === GROUP BOX === */
    QGroupBox {
        background-color: #ffffff;
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        margin-top: 30px; /* Để chừa chỗ cho title */
        font-size: 14px;
    }
    QGroupBox::title {
        subcontrol-origin: margin;
        subcontrol-position: top center;
        padding: 0 10px;
        color: #4DB6AC; /* Màu Xanh Ngọc Nhạt (Jade) */
        font-weight: bold;
        font-size: 16px;
    }

    /* === TEXT STYLES === */
    /* PBL Title - Xanh ngọc */
    QLabel#label_PBL {
        color: #20B2AA; /* Jade Green */
        font-size: 18px;
        font-weight: bold;
        text-transform: uppercase;
    }

    /* Project Name */
    QLabel#label_ProjectName {
        color: #555;
        font-style: italic;
        font-size: 15px;
    }

    /* === HIGHLIGHT PHẦN GVHD &amp; SV === */
    QLabel#label_Teacher, QLabel#label_StudentsTitle {
        color: #B71C1C; /* Đỏ đậm để nổi bật vai trò */
        font-weight: bold;
        font-size: 14px;
    }
    
    /* Tên Sinh viên */
    QLabel#label_Student1, QLabel#label_Student2 {
        color: #333;
        font-weight: 600; /* Semi-bold */
        font-size: 15px;
        padding: 2px;
    }

    /* Đường kẻ phân cách mờ */
    Line {
        color: #dcdcdc;
    }

    /* === BUTTONS === */
    QPushButton {
        background-color: #ffffff;
        border: 2px solid #4169E1; /* Viền King Blue */
        border-radius: 6px;
        color: #4169E1;
        padding: 8px 20px;
        font-weight: bold;
        font-size: 14px;
        min-width: 100px;
    }
    QPushButton:hover {
        background-color: #4169E1;
        color: white;
    }
    QPushButton#btnStop {
        border-color: #d32f2f;
        color: #d32f2f;
    }
    QPushButton#btnStop:hover {
        background-color: #d32f2f;
        color: white;
    }
   </string>
