  <property name="styleSheet">
   <string notr="true">
/* --- CÀI ĐẶT CHUNG (Giống File 1) --- */
QDialog#ArticleInputDialog {
    background-color: #f4f7f6;
    border: 4px solid #FFC085;
}
QWidget {
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
}
QScrollArea {
    border: none;
    background-color: transparent;
}
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin-top: 20px;
    padding-top: 15px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #20B2AA;
    font-weight: bold;
    left: 10px;
    top: 0px;
}
QLineEdit, QPlainTextEdit, QComboBox {
    background-color: #f9f9f9;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 8px;
    color: #333333;
}
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    background-color: #ffffff;
    border: 2px solid #20B2AA;
}

/* --- TÙY CHỈNH SPINBOX (Nút trái giảm, nút phải tăng - Giống File 1) --- */
QSpinBox, QDoubleSpinBox {
    background-color: #f9f9f9;
    border: 1px solid #cccccc;
    border-radius: 6px;
    color: #333333;
    padding-top: 5px;
    padding-bottom: 5px;
    /* Chừa chỗ 2 bên cho nút bấm để không che số */
    padding-left: 35px;
    padding-right: 35px;
    /* Căn giữa số */
    qproperty-alignment: AlignCenter;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    background-color: #ffffff;
    border: 2px solid #20B2AA;
}

/* Nút Tăng (Up-Button) -&gt; Đưa về bên PHẢI */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: right;
    width: 30px;
    height: 100%;
    border-left: 1px solid #cccccc;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #e0e0e0;
}

/* Nút Giảm (Down-Button) -&gt; Đưa về bên TRÁI */
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: left;
    width: 30px;
    height: 100%;
    border-right: 1px solid #cccccc;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: #e0e0e0;
}

/* Hiệu ứng khi di chuột vào nút tăng/giảm */
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #20B2AA;
}
