  <property name="styleSheet">
   <string notr="true">
    /* === CÀI ĐẶT CHUNG === */
    QWidget#SignUpForm {
        background-color: #f4f7f6; 
    }
    QWidget {
        font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    }

    /* === KHUNG CHỨA CHÍNH === */
    QWidget#container {
        background-color: #ffffff;
        border: 2px solid #20B2AA; /* Viền Xanh Ngọc Nhạt */
        border-radius: 12px;
    }

    /* === HEADER === */
    QWidget#headerWidget {
        background-color: #00264d; /* Nền xanh tối */
        border-left: 8px solid #FFD700; /* Sọc vàng */
        border-bottom: 4px solid #4169E1; /* Kẻ ngang King Blue */
        border-top-left-radius: 10px; 
        border-top-right-radius: 10px;
    }
    
    QLabel#welcomeLabel, QLabel#logoLabel, QLabel#subtitleLabel {
        color: #ffffff;
        background-color: transparent;
    }
    QLabel#welcomeLabel {
        font-size: 18px;
        font-weight: bold;
    }
    QLabel#subtitleLabel {
        font-size: 12px;
        font-style: italic;
        color: #dddddd;
    }

    /* === INPUT FIELDS === */
    QLabel {
        color: #333;
        font-weight: bold;
        font-size: 14px;
    }

    QLineEdit {
        background-color: #f9f9f9;
        border: 1px solid #ccc;
        border-radius: 6px;
        padding: 10px;
        font-size: 14px;
        color: #333;
    }

    QLineEdit:focus {
        background-color: #ffffff;
        border: 2px solid #20B2AA; /* Focus màu xanh ngọc */
    }

    /* === BUTTON === */
    QPushButton#signUpButton {
        background-color: #20B2AA; 
        color: white;
        font-weight: bold;
        font-size: 16px;
        border-radius: 6px;
        border: none;
    }
    QPushButton#signUpButton:hover {
        background-color: #17a098;
    }
    QPushButton#signUpButton:pressed {
        background-color: #13857e;
    }
   </string>
