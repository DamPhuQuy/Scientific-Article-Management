   <string notr="true">
/* --- CÀI ĐẶT CHUNG --- */
QDialog#ArticleConfirmRemoveDialog {
    background-color: #f4f7f6;
    border: 4px solid #e74c3c; /* Viền đỏ cảnh báo thay vì cam */
}
QWidget {
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
}

/* --- GROUP BOX --- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin-top: 10px;
    padding: 15px;
}

/* --- LABELS --- */
QLabel {
    color: #333333;
}
QLabel#labelInstruction {
    color: #c0392b; /* Màu đỏ đậm cho hướng dẫn cảnh báo */
    font-weight: bold;
    font-size: 13px;
}

/* --- INPUTS --- */
QLineEdit {
    background-color: #f9f9f9;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 8px;
    color: #333333;
}
QLineEdit:focus {
    background-color: #ffffff;
    border: 2px solid #e74c3c; /* Focus màu đỏ để cảnh báo */
}

/* --- BUTTONS --- */
QPushButton {
    border-radius: 6px;
    font-weight: bold;
    padding: 8px 15px;
    min-width: 80px;
    color: white;
}
/* Nút Remove (Nguy hiểm - Đỏ) */
QPushButton#btnRemove {
    background-color: #e74c3c;
    border: 2px solid #e74c3c;
}
QPushButton#btnRemove:hover {
    background-color: #c0392b;
}
QPushButton#btnRemove:pressed {
    background-color: #922b21;
}

/* Nút Cancel (Xám) */
QPushButton#btnCancel {
    background-color: #7f8c8d;
    border: 2px solid #7f8c8d;
}
QPushButton#btnCancel:hover {
    background-color: #636e72;
}
