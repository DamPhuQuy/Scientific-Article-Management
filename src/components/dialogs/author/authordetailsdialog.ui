   <string notr="true">
/* --- CÀI ĐẶT CHUNG --- */
QDialog#AuthorDetailsDialog {
    background-color: #f4f7f6;
    border: 4px solid #FFC085;
}
QWidget {
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
}

/* --- GROUP BOX (THẺ THÔNG TIN) --- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin: 10px;
    padding: 15px;
}

/* --- LABELS --- */
QLabel {
    color: #333333;
}
/* Nhãn tiêu đề field (ID, Country...) */
QLabel#lblID, QLabel#lblCountry, QLabel#lblField, QLabel#lblPubs {
    color: #555555;
    font-weight: bold;
}
/* Tên tác giả nổi bật */
QLabel#labelDetailName {
    color: #20B2AA;
    font-weight: 900;
    font-size: 18px;
    margin-bottom: 10px;
}
/* Giá trị chi tiết */
QLabel#labelDetailId, QLabel#labelDetailCountry, QLabel#labelDetailField, QLabel#labelDetailPubCount {
    color: #000000;
    font-weight: normal;
    background-color: #f9f9f9; /* Nền nhẹ để dễ nhìn */
    border: 1px solid #eeeeee;
    border-radius: 4px;
    padding: 5px;
}

/* --- BUTTON --- */
QPushButton {
    background-color: #20B2AA;
    border: 2px solid #20B2AA;
    border-radius: 6px;
    color: white;
    font-weight: bold;
    padding: 8px 20px;
}
QPushButton:hover {
    background-color: #17a098;
}
QPushButton:pressed {
    background-color: #0e6b65;
}
